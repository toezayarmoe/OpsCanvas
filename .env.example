PORT=4000
APP_PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:4000
NODE_ENV=development

# Docker Compose uses DB_HOST=mysql. For running Node outside Compose, use 127.0.0.1.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cliflow
DB_USER=cliflow
DB_PASSWORD=local-cliflow-password
MYSQL_ROOT_PASSWORD=local-root-password

SESSION_DAYS=7
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
ENABLE_TERMINAL=true
